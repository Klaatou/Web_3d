# cache (dist/ est suivi par git : les fichiers prêts à l'emploi y sont)
.cache/
extraire_batiments.cache/
__pycache__/
*.pyc

# données privées ou propres à une installation : ne jamais committer
presence_identities.json
presence_bans.json
presence_visits_keys.json
presence_creators.json
presence.log*
*.log
zones*.json
!tests/data/zA.json
*.reglages.json
regions.json
*.vignette.jpg

# pages et modèles générés
*.html
!src/*.html
!dist/*.html
!tests/essai_importmap.html
*.glb
!tests/data/*.glb

# notes de travail personnelles et sauvegardes de patchs : ne jamais committer
REGLES.md
_bak/
patch_*.py
*.zones.json
*.jsonl
!docs/samples/*.jsonl

# sources des paquets prêts à l'emploi (paquets/) : exceptions aux règles ci-dessus ; les zips fabriqués ne sont pas suivis
!paquets/**
paquets-zip/
/paquets-sources.zip

# convoar fourni dans dist/convoar : fichiers que oar2glb.py fabrique a la premiere conversion (lanceur compile avec csc.exe)
dist/convoar/convoar_inv.*

